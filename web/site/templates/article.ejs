<article class="card bg-base-100 border border-base-300 shadow-none">
  <div class="card-body">
    <nav class="text-sm opacity-70" aria-label="面包屑"><a class="link link-hover" href="/">首页</a> / <span><%= page?.Title %></span></nav>
    <p class="kicker text-xs opacity-60"><time datetime="<%= page?.ISO %>"><%= page?.Date %></time> · <%= page?.Views %> 次阅读</p>
    <h1 class="text-2xl font-semibold"><%= page?.Title %></h1>
    <p class="opacity-70"><%= page?.Summary %></p>
    <% if (shown(page?.Category)) { %><p class="text-sm opacity-70"><%= page?.Category %></p><% } %>
    <% if (shown(page?.Cover)) { %><img class="max-w-full rounded" src="<%= safeURL(page?.Cover) %>" alt="<%= page?.Title %>"><% } %>
    <% if (shown(page?.Embed)) { %><iframe class="w-full aspect-video rounded" src="<%= safeURL(page?.Embed) %>" title="<%= page?.Title %>视频" loading="lazy" allowfullscreen></iframe>
    <% } else if (shown(page?.Video)) { %><p><a class="btn btn-outline btn-sm" href="<%= safeURL(page?.Video) %>" target="_blank" rel="noopener noreferrer">观看视频</a></p><% } %>
    <% if (shown(page?.Rich)) { %><nav data-article-toc class="border border-base-300 rounded p-3" aria-label="文章目录" hidden></nav><div class="article-body"><%- page?.HTML ?? '' %></div><% } else { %><div class="whitespace-pre-wrap"><%= page?.Body %></div><% } %>
  </div>
</article>
<%- partial("comments", page) %>
