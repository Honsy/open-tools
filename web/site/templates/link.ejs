<a class="site-link card card-compact <%= page?.Layout %> bg-base-200 hover:bg-base-300 shadow-none" href="<%= safeURL(page?.Href) %>" title="<%= page?.Desc %>" data-link="<%= page?.JSON %>"><span class="mark"><% if (shown(page?.Host)) { %><img alt="" data-src="<%= safeURL(page?.Icon) %>" decoding="async" onload="this.nextElementSibling.remove()" onerror="this.remove()"><% } %><b><%= page?.Letter %></b></span><span class="meta"><span class="name"><%= page?.Name %></span><% if (shown(page?.Desc)) { %><span class="desc"><%= page?.Desc %></span><% } %></span><button class="star<%= page?.Star %>" type="button" data-star="<%= page?.JSON %>" aria-label="<% if (shown(page?.Star)) { %>取消收藏<% } else { %>收藏<% } %>">★</button></a>
