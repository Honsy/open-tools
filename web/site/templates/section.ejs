<% const tabs = page?.Tabs ?? []; const selected = tabs.find(tab => tab.On); %>
<section class="mt-6" id="sec-<%= page?.Slug %>"<% if (tabs.length > 1) { %> data-catalog-tabs<% if (page?.Preview) { %> data-catalog-preview<% } %><% } %>>
  <% if (shown(page?.Groups) && page?.Fold) { %>
  <div class="collapse collapse-arrow bg-base-200 rounded-box">
    <input type="checkbox" aria-label="展开<%= page?.Name %>" />
    <div class="collapse-title font-semibold min-h-12 py-3"><%= page?.Name %></div>
    <div class="collapse-content"><%- partial("taggroups", page) %></div>
  </div>
  <% } else { %>
  <div class="mb-3 flex flex-wrap items-center gap-2<% if (page?.Preview) { %> max-sm:grid max-sm:grid-cols-[minmax(0,1fr)_auto]<% } %>">
    <% if (!page?.HideTitle) { %><h2 class="text-base font-semibold px-1"><%= page?.Name %></h2><% } %>
    <% if (tabs.length > 1) { %>
    <div class="tabs tabs-box min-w-0 max-sm:flex-nowrap max-sm:overflow-x-auto<% if (page?.Preview) { %> max-sm:col-span-2 max-sm:row-start-2<% } else { %> max-sm:w-full<% } %>" role="group" aria-label="<%= page?.Name %>子分类">
      <% for (const tab of tabs) { %>
      <a class="tab shrink-0<% if (tab.On) { %> tab-active font-medium text-primary<% } %>" href="/c/<%= tab.Slug %>" id="tab-<%= tab.Slug %>" data-catalog-tab="<%= tab.Slug %>" data-scroll="sec-<%= page.Slug %>" aria-controls="panel-<%= page.Slug %>-<%= tab.Slug %>"<% if (tab.On) { %> aria-current="true"<% } %>><%= tab.Name %></a>
      <% } %>
    </div>
    <% } %>
    <% if (shown(page?.More)) { %><a class="btn btn-ghost btn-sm ml-auto text-primary<% if (page?.Preview) { %> max-sm:col-start-2 max-sm:row-start-1<% } %>" data-catalog-more href="<%= safeURL(selected ? "/c/" + selected.Slug : page.More) %>" aria-label="查看全部<%= selected?.Name ?? page?.Name %>">查看全部 <span aria-hidden="true">→</span></a><% } %>
  </div>
  <% if (shown(page?.Groups)) { %>
  <%- partial("taggroups", page) %>
  <% } else { %>
  <% for (const tab of tabs) { %>
  <div class="tab-panel" id="panel-<%= page.Slug %>-<%= tab.Slug %>" data-catalog-panel="<%= tab.Slug %>"<% if (!tab.On) { %> hidden<% } %>>
    <% if (tab.On) { %>
    <%- partial("catalogPanel", { Tab: tab, Layout: page.Layout, Preview: page.Preview }) %>
    <% } else { %>
    <div class="empty-state">
      <p data-catalog-status role="status">正在加载<%= tab.Name %>…</p>
      <a class="btn btn-ghost btn-sm mt-2" href="/c/<%= tab.Slug %>" data-catalog-fallback hidden>打开<%= tab.Name %>分类</a>
    </div>
    <% } %>
  </div>
  <% } %>
  <% } %>
  <% } %>
</section>
