<div class="flex flex-col gap-2">
  <% for (const group of (page?.Groups ?? [])) { %>
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-xs font-medium opacity-60 w-14 shrink-0"><%= group.name %></span>
    <% for (const tag of (group.tags ?? [])) { %><a class="badge badge-ghost" href="/search?q=<%= query(tag) %>"><%= tag %></a><% } %>
  </div>
  <% } %>
  <a class="btn btn-primary btn-sm w-fit mt-1" href="/random">随机网址</a>
</div>
