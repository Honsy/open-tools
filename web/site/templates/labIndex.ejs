<h1 class="text-2xl font-semibold mb-4">在线工具</h1>
<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
  <% for (const item1 of (page ?? [])) { %><a class="card bg-base-100 border border-base-300 no-underline text-base-content" href="/tools/<%= item1?.Slug %>">
    <div class="card-body"><span class="text-xs opacity-70"><%= item1?.Group %></span><h2 class="font-semibold"><%= item1?.Name %></h2><p class="text-sm opacity-70"><%= item1?.Desc %></p></div>
  </a><% } %>
</div>
